---
import { localizePath, slugPath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
  /** Slug de la pagina actual: el selector de idiomas tiene que llevarte a ella. */
  slug: string;
}

const { lang, slug } = Astro.props;
const t = useTranslations(lang);
---

<nav class="navbar navbar-expand-lg" style="background-color: black;">
  <div class="container-fluid">
    <ul class="navbar-nav mx-auto">
      <li class="nav-item">
        <a class="nav-link text-white" href={localizePath(slugPath('home'), lang)}>
          <i class="bi bi-house-fill"></i> {t('nav.home')}
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white" href="#introduccion">
          <i class="fas fa-user"></i> {t('nav.intro')}
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white" href="#habilidades">
          <i class="fas fa-code"></i> {t('nav.skills')}
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white" href="#contacto">
          <i class="fas fa-envelope"></i> {t('nav.contact')}
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white" href="#proyectos">
          <i class="fas fa-project-diagram"></i> {t('nav.projects')}
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-white" href="#asistente">
          <i class="fas fa-robot"></i> {t('nav.assistant')}
        </a>
      </li>
    </ul>
    <LangSwitch lang={lang} slug={slug} />
  </div>
</nav>
