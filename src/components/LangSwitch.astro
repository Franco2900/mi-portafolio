---
import { hasSlug } from '../content';
import { languages, locales, type Lang } from '../i18n/ui';
import { localizePath, slugPath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Slug de la pagina actual, para que el cambio lleve a la MISMA pagina. */
  slug: string;
}

const { lang, slug } = Astro.props;
const t = useTranslations(lang);

// Si la pagina todavia no existe en otro idioma, ese boton cae al home de ese
// idioma en vez de a un 404. Hoy los tres idiomas estan completos, pero una
// traduccion a medias tiene que seguir compilando y sin enlaces muertos.
const targetOf = (code: Lang) => (hasSlug(code, slug) ? slug : 'home');
---

<nav
  class="lang-switch d-flex flex-wrap justify-content-center gap-2 py-2"
  aria-label={t('nav.language')}
  data-lang-switcher
>
  {locales.map((code) => (
    <a
      class={`btn btn-sm d-inline-flex align-items-center gap-2 ${
        code === lang ? 'btn-light fw-bold' : 'btn-outline-light'
      }`}
      href={localizePath(slugPath(targetOf(code)), code)}
      hreflang={languages[code].tag}
      aria-current={code === lang ? 'page' : undefined}
      data-lang={code}
    >
      <span class={`fi fi-${languages[code].flag}`} aria-hidden="true"></span>
      <span>{languages[code].name}</span>
    </a>
  ))}
</nav>

<style>
  /*
   * En pantallas chicas el navbar apila sus items en columna y ocupa el ancho
   * completo, asi que el selector tiene que bajar a su propia fila: si comparte
   * la fila con la lista queda comprimido y se corta el nombre del idioma.
   * Desde `lg` el navbar es horizontal y el selector entra a la derecha.
   */
  .lang-switch {
    flex-basis: 100%;
  }

  @media (min-width: 992px) {
    .lang-switch {
      flex-basis: auto;
    }
  }
</style>
