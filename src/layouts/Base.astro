---
import { url } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Fondo from '../components/Fondo.astro';
import NavbarIndex from '../components/NavbarIndex.astro';
import NavbarProject from '../components/NavbarProject.astro';

interface Props {
  /** Texto de la pestaña y del resultado en Google. Unico por pagina. */
  title: string;
  /** Resumen de ~155 caracteres para Google y para las tarjetas al compartir. */
  description: string;
  /** Ruta relativa de la pagina, usada para armar la URL canonica. '' = home. */
  path?: string;
  /** Home usa el navbar con anclas internas; los proyectos el de secciones. */
  nav?: 'home' | 'project';
  /** Imagen de la tarjeta al compartir, relativa a la raiz del sitio. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Hojas de estilo propias de la pagina, en orden de cascada. */
  css?: string[];
}

const {
  title,
  description,
  path = '',
  nav = 'project',
  ogImage = 'images/og/og-home.jpg',
  ogType = 'website',
  css = [],
} = Astro.props;

const SITE = 'https://franco2900.github.io/mi-portafolio/';
const canonical = new URL(path, SITE).href;
const ogImageUrl = new URL(ogImage, SITE).href;
---

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/x-icon" href={url("images/style/favicon.ico")}>

  <title>{title}</title>

  <!-- Open Graph: lo leen LinkedIn, WhatsApp, Discord, Slack y Telegram.
       Tienen que estar en el HTML crudo porque esos bots no ejecutan JavaScript. -->
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content="Franco Figueroa">
  <meta property="og:locale" content="es_AR">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Portafolio de Franco Figueroa">

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>

  <!-- Orden de cascada: layout.css antes de Bootstrap, igual que antes de la migracion.
       `integrity` + `crossorigin` fijan cada hoja a una version exacta: si el CDN
       sirve otro contenido, el navegador la descarta en vez de ejecutarla. -->
  <link rel="stylesheet" href={url("css/layout.css")}>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
    crossorigin="anonymous"
  >
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
    rel="stylesheet"
    integrity="sha384-4LISF5TTJX/fLmGSxO53rV4miRxdg84mZsxmO8Rx5jGtp/LbrixFETvWa5a6sESd"
    crossorigin="anonymous"
  >
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    rel="stylesheet"
    integrity="sha384-t1nt8BQoYMLFN5p42tRAtuAAFQaCQODekUVeKKZrEnEyp4H2R0RHFz0KWpmj7i8g"
    crossorigin="anonymous"
  >
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/flag-icons/6.6.6/css/flag-icons.min.css"
    rel="stylesheet"
    integrity="sha384-TeDUCuZ+Uyp1Vv0n275nnm//ANAlP5GFHCnSF4iiAdrYmBZMM6syYgykpq4kGTqL"
    crossorigin="anonymous"
  >
  <link rel="stylesheet" href={url("css/fondo.css")}>
  <link rel="stylesheet" href={url("css/footer.css")}>
  {css.map((href) => <link rel="stylesheet" href={url(href)} />)}
</head>

<body class="light-mode">

  <Header />
  {nav === 'home' ? <NavbarIndex /> : <NavbarProject />}
  <Fondo />

  <main id="main-container" class="container">
    <slot />
  </main>

  <Footer />

  <!-- Sin Bootstrap JS: el navbar no usa toggler, collapse, modal, dropdown ni tooltip.
       Sin Font Awesome JS: la version CSS ya dibuja los mismos iconos con menos peso.
       El sitio queda con un solo script propio (el zoom de imagenes). -->
  <script is:inline src={url("js/zoomImagenes.js")}></script>

  <!-- El email se arma en runtime para no dejarlo en texto plano en el HTML. -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.email').forEach((el) => {
        if (!el.textContent) el.textContent = 'franco2900' + '@' + 'gmail.com';
      });
    });
  </script>

</body>

</html>
