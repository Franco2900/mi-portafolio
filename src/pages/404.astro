---
import Base from '../layouts/Base.astro';
import { pages } from '../data/pages';

const meta = pages['notFound'];
// Un 404 se sirve para cualquier ruta faltante, asi que el link de vuelta
// tiene que ser absoluto respecto del base del sitio.
const home = import.meta.env.BASE_URL;
---

<Base title={meta.title} description={meta.description} path="404.html" nav="project">
  <h1>{meta.h1}</h1>

  <p class="text-center">
    La dirección que buscás no existe o cambió de lugar.
  </p>

  <div class="text-center my-4">
    <a class="btn btn-primary" href={home}>Volver al inicio</a>
  </div>

  <p class="text-center">
    También podés escribirme a <span class="email"></span>.
  </p>
</Base>
